{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": { "root": "backend", "runtime": "node", "entrypoint": "server.js", "devCommand": "node server.js" },
    "frontend": {
      "root": "frontend",
      "runtime": "node",
      "entrypoint": "server.js",
      "devCommand": "node server.js",
      "functions": {
        "server.js": { "includeFiles": "{index.html,src/**}" }
      }
    },
    "mobile": {
      "root": "mobile",
      "runtime": "node",
      "entrypoint": "server.js",
      "devCommand": "node server.js",
      "functions": {
        "server.js": { "includeFiles": "{index.html,manifest.webmanifest,src/**}" }
      }
    }
  },
  "redirects": [
    { "source": "/mobile", "destination": "/mobile/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/mobile/:path*", "destination": { "service": "mobile" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
